  .v-select:focus { outline: none; border-color: #F5A623; }
</style>

<script>
  // Dropdowns auto-submit their GET form — the server does the filtering.
  document.getElementById('v-filters')?.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).tagName === 'SELECT') (e.currentTarget as HTMLFormElement).submit();
  });
</script>
