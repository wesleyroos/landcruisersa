---
// Shared template for the Hilux and Fortuner verticals (P28). Same playbook as
// /fj-cruiser/ and /classics/ — top-level page, live stats strips, citable
// capsule — but with SERVER-SIDE pagination: these two families hold thousands
// of listings (vs. FJ's ~240), so rendering every card (FJ pattern) or shipping
// the whole set as client JSON (/listings/ pattern) would blow the page weight.
// Filters and sort are links, so every view is crawlable and nothing needs JS.
//
// These models live in segment 'toyota-4x4' — they are deliberately NOT part of
// the Land Cruiser classifieds, stats, IG engine, or LC citable claims. This
// page + detail pages + /market/ + valuation is their entire public surface.
import Base from '@/layouts/Base.astro';
import { SITE } from '@/data/site';
import { db } from '@/db/index';
import { listings } from '@/db/schema';
import { and, eq, desc, inArray } from 'drizzle-orm';
import { firstThumb, hasUsablePhoto } from '@/lib/photos';
import { getRecentPriceChanges } from '@/lib/price-changes';

interface Props {
  family: 'Hilux' | 'Fortuner';
  pathBase: string;                       // '/hilux/'
  gd6Model: string;                       // 'hilux-gd6'
  d4dModel: string;                       // 'hilux-d4d'
  title: string;                          // 'Toyota Hiluxes For Sale in South Africa'
  eyebrow: string;
  showCabFilter?: boolean;                // Hilux only
}
const { family, pathBase, gd6Model, d4dModel, title, eyebrow, showCabFilter = false } = Astro.props;

const PAGE_SIZE = 24;
const params = Astro.url.searchParams;
const era  = ['gd6', 'd4d'].includes(params.get('era') ?? '') ? params.get('era')! : 'all';
const cab  = showCabFilter && ['double', 'single', 'xtra'].includes(params.get('cab') ?? '') ? params.get('cab')! : 'all';
const sort = params.get('sort') === 'price' ? 'price' : 'newest';

// Dropdown filters — same set as /listings/, but server-side (this page is
// link-navigated, not a client dataset). Bracket values mirror the listings
// page presets so the two surfaces feel like one system.
const PROVINCES = ['Gauteng', 'Western Cape', 'KwaZulu-Natal', 'Eastern Cape', 'Limpopo', 'Mpumalanga', 'North West', 'Free State', 'Northern Cape'];
const YEAR_OPTS: [string, string, number, number][] = [
  ['', 'Any year', 0, 9999],
  ['2020', '2020 & newer', 2020, 9999],
  ['2016-2019', '2016 – 2019', 2016, 2019],
  ['2010-2015', '2010 – 2015', 2010, 2015],
  ['pre2010', 'Pre-2010', 0, 2009],
];
const PRICE_OPTS: [string, string, number, number][] = [
  ['', 'Any price', 0, Infinity],
  ['0-300', 'Under R300k', 0, 300_000],
  ['300-600', 'R300k – R600k', 300_000, 600_000],
  ['600-1000', 'R600k – R1m', 600_000, 1_000_000],
  ['1000+', 'Over R1m', 1_000_000, Infinity],
];
const KM_OPTS: [string, string, number, number][] = [
  ['', 'Any mileage', 0, Infinity],
  ['0-50', 'Under 50 000 km', 0, 50_000],
  ['50-100', '50 000 – 100 000 km', 50_000, 100_000],
  ['100-200', '100 000 – 200 000 km', 100_000, 200_000],
  ['200+', 'Over 200 000 km', 200_000, Infinity],
];
const pick = (opts: [string, string, number, number][], key: string | null) =>
  opts.find(o => o[0] === (key ?? '')) ?? opts[0];
const yearSel  = pick(YEAR_OPTS, params.get('year'));
const priceSel = pick(PRICE_OPTS, params.get('price'));
const kmSel    = pick(KM_OPTS, params.get('km'));
const provSel  = PROVINCES.includes(params.get('province') ?? '') ? params.get('province')! : '';
const transSel = ['manual', 'automatic'].includes(params.get('trans') ?? '') ? params.get('trans')! : '';
// Typed price bounds — Wesley: presets are fine to keep, but typing min/max
// must always be possible. When either is set it replaces the preset bracket.
const pmin = Math.max(0, Number(params.get('pmin')) || 0);
const pmaxRaw = Number(params.get('pmax')) || 0;
const pmax = pmaxRaw > 0 ? pmaxRaw : Infinity;
const customPrice = pmin > 0 || isFinite(pmax);

const rows = db.select({
  slug: listings.slug, title: listings.title, model: listings.model, year: listings.year,
  price: listings.price, mileage: listings.mileage, province: listings.province,
  transmission: listings.transmission, photos: listings.photos,
  listing_type: listings.listing_type, featured: listings.featured,
}).from(listings)
  .where(and(eq(listings.status, 'active'), inArray(listings.model, [gd6Model, d4dModel])))
  .orderBy(desc(listings.featured), desc(listings.created_at))
  .all()
  .filter(l => hasUsablePhoto(l.photos));

function cabOf(t: string): string {
  if (/xtra|extra\s?cab/i.test(t)) return 'xtra';
  if (/double\s?cab|d\/?cab|\bd\/c\b/i.test(t)) return 'double';
  if (/single\s?cab|s\/?cab|\bs\/c\b/i.test(t)) return 'single';
  return 'other';
}

function stats(model: string) {
  const group = rows.filter(l => l.model === model);
  const priced = group.filter(l => l.listing_type === 'for_sale' && l.price > 0).map(l => l.price).sort((a, b) => a - b);
  const n = priced.length;
  const median = n ? (n % 2 ? priced[(n - 1) / 2] : Math.round((priced[n / 2 - 1] + priced[n / 2]) / 2)) : 0;
  const kms = group.filter(l => l.mileage > 0).map(l => l.mileage);
  return {
    count: group.length, priceCount: n, median,
    min: n ? priced[0] : 0, max: n ? priced[n - 1] : 0,
    avgKm: kms.length ? Math.round(kms.reduce((s, m) => s + m, 0) / kms.length) : null,
  };
}
const gd6 = stats(gd6Model);
const d4d = stats(d4dModel);

// Filter → paginate. All server-side; the pills and dropdowns are plain links/forms.
let filtered = rows;
if (era !== 'all') filtered = filtered.filter(l => l.model === (era === 'gd6' ? gd6Model : d4dModel));
if (cab !== 'all') filtered = filtered.filter(l => cabOf(l.title) === cab);
if (yearSel[0])  filtered = filtered.filter(l => l.year >= yearSel[2] && l.year <= yearSel[3]);
if (customPrice) filtered = filtered.filter(l => l.listing_type === 'for_sale' && l.price >= pmin && l.price <= pmax);
else if (priceSel[0]) filtered = filtered.filter(l => l.listing_type === 'for_sale' && l.price >= priceSel[2] && l.price <= priceSel[3]);
if (kmSel[0])    filtered = filtered.filter(l => l.mileage >= kmSel[2] && l.mileage <= kmSel[3]);
if (provSel)     filtered = filtered.filter(l => l.province === provSel);
if (transSel)    filtered = filtered.filter(l => l.transmission === transSel);
if (sort === 'price') {
  filtered = [...filtered].sort((a, b) =>
    (a.listing_type === 'for_sale' && a.price > 0 ? a.price : Infinity) -
    (b.listing_type === 'for_sale' && b.price > 0 ? b.price : Infinity));
}
const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(totalPages, Math.max(1, Number(params.get('page')) || 1));
const pageRows = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

// Link helper — preserves the other filters, drops defaults so the canonical
// unfiltered view is the bare path.
function href(over: Record<string, string | number>) {
  const q = new URLSearchParams();
  const v = {
    era, cab, sort, page: 1,
    year: yearSel[0], price: priceSel[0], km: kmSel[0], province: provSel, trans: transSel,
    pmin: pmin > 0 ? pmin : '', pmax: isFinite(pmax) ? pmax : '',
    ...over,
  } as Record<string, string | number>;
  if (v.era !== 'all') q.set('era', String(v.era));
  if (v.cab !== 'all') q.set('cab', String(v.cab));
  if (v.sort !== 'newest') q.set('sort', String(v.sort));
  for (const k of ['year', 'price', 'km', 'province', 'trans', 'pmin', 'pmax']) if (v[k]) q.set(k, String(v[k]));
  if (Number(v.page) > 1) q.set('page', String(v.page));
  const s = q.toString();
  return pathBase + (s ? `?${s}` : '');
}

const priceChanges = getRecentPriceChanges();
const dropBySlug = new Map<string, number>();
for (const l of pageRows) {
  const c = priceChanges.get(l.slug) ?? 0;
  if (c < 0) dropBySlug.set(l.slug, Math.abs(c));
}

const R = (n: number) => 'R' + n.toLocaleString('en-ZA');
const km = (n: number) => n.toLocaleString('en-ZA') + ' km';
const kR = (n: number) =>
  n >= 1_000_000 ? 'R' + (n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 1) + 'm' : 'R' + Math.round(n / 1000) + 'k';

const canonicalUrl = `${SITE.url}${pathBase}`;
const total = rows.length;
const descParts: string[] = [];
if (gd6.priceCount >= 2) descParts.push(`GD-6 (2016+) median asking ${R(gd6.median)}`);
if (d4d.priceCount >= 2) descParts.push(`D-4D from ${R(d4d.min)}`);
const description = `Browse ${total.toLocaleString('en-ZA')} Toyota ${family}s for sale in South Africa, aggregated from dealers and platforms nationwide${descParts.length ? ` — ${descParts.join(' · ')}` : ''}. Updated daily.`;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": `${family}s`, "item": canonicalUrl },
  ],
};
---

<Base title={`${title} — Land Cruiser SA`} description={description} schema={breadcrumb}>

<div class="bg-[#111111]">
  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <nav class="flex items-center gap-2 text-xs text-white/40 mb-4">
        <a href="/" class="hover:text-[#F5A623] transition-colors">Home</a>
        <span>›</span>
        <span class="text-white/70">{family}s</span>
      </nav>
      <p class="text-[#F5A623] font-heading font-bold uppercase tracking-widest text-xs mb-2">{eyebrow}</p>
      <h1 class="font-heading font-bold uppercase text-white text-4xl md:text-5xl leading-none mb-3">{title}</h1>
      <p class="text-white/50 text-sm">{total.toLocaleString('en-ZA')} active listings, aggregated across South Africa's major platforms · updated daily</p>
    </div>
    <a href="/listings/submit/" class="inline-flex items-center gap-2 bg-[#F5A623] text-[#111111] font-heading font-bold uppercase tracking-wide px-6 py-3.5 rounded-xl hover:bg-[#D4881A] transition-colors text-sm self-start sm:self-auto touch-manipulation whitespace-nowrap">
      + List Your {family}
    </a>
  </div>
</div>
<div class="h-1 bg-[#F5A623]"></div>

<div class="max-w-7xl mx-auto px-4 py-8 sm:py-10">

  {(gd6.priceCount >= 2 || d4d.priceCount >= 2) && (
    <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
      {gd6.priceCount >= 2 && (
        <div class="bg-white border border-[#DDD9D3] rounded-xl px-5 py-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[#F5A623] mb-2">{family} GD-6 · 2016 onward</p>
          <div class="grid grid-cols-3 gap-x-4 gap-y-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Median asking</p>
              <p class="font-heading font-bold text-lg text-[#111111]">{R(gd6.median)}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Range</p>
              <p class="font-heading font-bold text-lg text-[#111111]">{kR(gd6.min)} – {kR(gd6.max)}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">For sale</p>
              <p class="font-heading font-bold text-lg text-[#111111]">{gd6.count.toLocaleString('en-ZA')}</p>
            </div>
          </div>
        </div>
      )}
      {d4d.priceCount >= 2 && (
        <div class="bg-white border border-[#DDD9D3] rounded-xl px-5 py-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[#F5A623] mb-2">{family} D-4D · pre-2016</p>
          <div class="grid grid-cols-3 gap-x-4 gap-y-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Median asking</p>
              <p class="font-heading font-bold text-lg text-[#111111]">{R(d4d.median)}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Range</p>
              <p class="font-heading font-bold text-lg text-[#111111]">{kR(d4d.min)} – {kR(d4d.max)}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">For sale</p>
              <p class="font-heading font-bold text-lg text-[#111111]">{d4d.count.toLocaleString('en-ZA')}</p>
            </div>
          </div>
        </div>
      )}
    </div>
  )}

  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-1.5 flex-wrap">
      <a href={href({ era: 'all' })} class={`filter-pill ${era === 'all' ? 'active' : ''}`}>All ({total.toLocaleString('en-ZA')})</a>
      <a href={href({ era: 'gd6' })} class={`filter-pill ${era === 'gd6' ? 'active' : ''}`}>GD-6 · 2016+ ({gd6.count.toLocaleString('en-ZA')})</a>
      <a href={href({ era: 'd4d' })} class={`filter-pill ${era === 'd4d' ? 'active' : ''}`}>D-4D · pre-2016 ({d4d.count.toLocaleString('en-ZA')})</a>
      {showCabFilter && (
        <>
          <span class="text-[#DDD9D3] mx-1">|</span>
          <a href={href({ cab: 'all' })} class={`filter-pill ${cab === 'all' ? 'active' : ''}`}>Any cab</a>
          <a href={href({ cab: 'double' })} class={`filter-pill ${cab === 'double' ? 'active' : ''}`}>Double cab</a>
          <a href={href({ cab: 'single' })} class={`filter-pill ${cab === 'single' ? 'active' : ''}`}>Single cab</a>
          <a href={href({ cab: 'xtra' })} class={`filter-pill ${cab === 'xtra' ? 'active' : ''}`}>Xtra cab</a>
        </>
      )}
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-xs text-[#9CA3AF] mr-1">Sort:</span>
      <a href={href({ sort: 'newest' })} class={`filter-pill ${sort === 'newest' ? 'active' : ''}`}>Newest</a>
      <a href={href({ sort: 'price' })} class={`filter-pill ${sort === 'price' ? 'active' : ''}`}>Price: low → high</a>
    </div>
  </div>

  <!-- Dropdown filters — a GET form (auto-submits on change), so every filtered
       view is a real URL: shareable, crawlable, and back-button friendly. -->
  <form id="v-filters" method="get" action={pathBase} class="flex flex-wrap gap-2.5 mb-8">
    {era !== 'all' && <input type="hidden" name="era" value={era} />}
    {cab !== 'all' && <input type="hidden" name="cab" value={cab} />}
    {sort !== 'newest' && <input type="hidden" name="sort" value={sort} />}
    <select name="year" class="v-select" aria-label="Year">
      {YEAR_OPTS.map(([v, label]) => <option value={v} selected={v === yearSel[0]}>{label}</option>)}
    </select>
    <select name="province" class="v-select" aria-label="Province">
      <option value="" selected={!provSel}>All provinces</option>
      {PROVINCES.map(p => <option value={p} selected={p === provSel}>{p}</option>)}
    </select>
    <select name="price" class="v-select" aria-label="Price bracket">
      {PRICE_OPTS.map(([v, label]) => <option value={v} selected={!customPrice && v === priceSel[0]}>{label}</option>)}
    </select>
    <div class="flex items-center gap-1.5">
      <input type="number" inputmode="numeric" min="0" step="10000" name="pmin" value={pmin > 0 ? pmin : ''} placeholder="Min R" aria-label="Minimum price" class="v-select w-28" />
      <span class="text-[#9CA3AF]">–</span>
      <input type="number" inputmode="numeric" min="0" step="10000" name="pmax" value={isFinite(pmax) ? pmax : ''} placeholder="Max R" aria-label="Maximum price" class="v-select w-28" />
      <button type="submit" class="filter-pill" style="min-height:44px;">Go</button>
    </div>
    <select name="km" class="v-select" aria-label="Mileage">
      {KM_OPTS.map(([v, label]) => <option value={v} selected={v === kmSel[0]}>{label}</option>)}
    </select>
    <select name="trans" class="v-select" aria-label="Transmission">
      <option value="" selected={!transSel}>Any transmission</option>
      <option value="manual" selected={transSel === 'manual'}>Manual</option>
      <option value="automatic" selected={transSel === 'automatic'}>Automatic</option>
    </select>
    <noscript><button type="submit" class="filter-pill">Apply</button></noscript>
    {(yearSel[0] || priceSel[0] || kmSel[0] || provSel || transSel || customPrice) && (
      <a href={href({ year: '', price: '', km: '', province: '', trans: '', pmin: '', pmax: '' })} class="self-center text-sm font-semibold text-[#D4881A] hover:underline">Clear filters</a>
    )}
  </form>

  {pageRows.length === 0 ? (
    <div class="text-center py-24">
      <p class="text-[#6B7280] text-lg mb-4">Nothing matches that filter right now.</p>
      <a href={pathBase} class="text-sm font-semibold text-[#D4881A] hover:underline">Clear filters</a>
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {pageRows.map((l, i) => (
        <a
          href={`/listings/${l.slug}/`}
          class="group border rounded-xl overflow-hidden transition-all flex flex-col bg-white border-[#DDD9D3] hover:border-[#F5A623] hover:shadow-md"
        >
          <div class="card-img">
            <img
              src={firstThumb(l.photos)}
              alt={l.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width="800" height="500"
              loading={i < 6 ? 'eager' : 'lazy'}
              fetchpriority={i < 3 ? 'high' : 'auto'}
              decoding="async"
            />
            <div class="card-badges">
              {l.featured && <span class="card-badge card-badge-featured">★ Featured</span>}
              {l.province && <span class="card-badge">{l.province}</span>}
            </div>
            {dropBySlug.has(l.slug) && (
              <span class="card-badge-drop">▼ R{dropBySlug.get(l.slug)!.toLocaleString('en-ZA')} drop</span>
            )}
          </div>
          <div class="p-4 sm:p-5 flex flex-col flex-1">
            <h2 class="font-heading font-bold uppercase text-base leading-tight mb-1 group-hover:text-[#F5A623] transition-colors line-clamp-2 text-[#111111]">
              {l.title}
            </h2>
            <p class="text-xs mb-4 truncate text-[#6B7280]">
              {l.mileage > 0 ? `${km(l.mileage)} · ` : ''}{l.transmission === 'manual' ? 'Manual' : 'Auto'} · {l.province}
            </p>
            <div class="mt-auto">
              {l.listing_type === 'for_sale' && l.price > 0
                ? <p class="font-heading font-bold text-2xl text-[#111111]">{R(l.price)}</p>
                : <span class="text-xs font-bold text-[#F5A623] uppercase tracking-wide">POA</span>
              }
            </div>
          </div>
        </a>
      ))}
    </div>
  )}

  {totalPages > 1 && (
    <nav class="mt-8 flex items-center justify-center gap-2 text-sm" aria-label="Pagination">
      {page > 1 && <a href={href({ page: page - 1 })} class="filter-pill">← Prev</a>}
      <span class="text-[#6B7280] px-2">Page {page} of {totalPages.toLocaleString('en-ZA')}</span>
      {page < totalPages && <a href={href({ page: page + 1 })} class="filter-pill">Next →</a>}
    </nav>
  )}

  <!-- Citable capsule — the answer block LLMs and featured snippets pick up -->
  <div class="mt-12">
    <h2 class="font-heading font-bold uppercase text-xl text-[#111111] mb-3">The {family} range, explained</h2>
    <p class="text-sm text-[#4A4A4A] leading-relaxed max-w-3xl">
      <slot name="capsule" />
    </p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3 text-sm">
      <a href={`/market/${gd6Model}/`} class="font-semibold text-[#D4881A] hover:underline">{family} GD-6 market data →</a>
      <a href={`/market/${d4dModel}/`} class="font-semibold text-[#D4881A] hover:underline">{family} D-4D market data →</a>
      <a href={`/valuation/${gd6Model}/`} class="font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">Own one? See what it's worth →</a>
    </div>
  </div>

  <!-- Sell CTA -->
  <div class="mt-12 p-5 bg-[#F5F3EE] border border-[#DDD9D3] rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="flex-1">
      <p class="text-xs font-bold uppercase tracking-widest text-[#F5A623] mb-1">Selling?</p>
      <p class="font-heading font-bold uppercase text-[#111111] text-base">List your {family} free</p>
      <p class="text-sm text-[#6B7280] mt-0.5">Free listing, reviewed within 24 hours — a national audience of Toyota 4x4 buyers.</p>
    </div>
    <a href="/listings/submit/" class="flex-shrink-0 inline-flex items-center bg-[#111111] text-white font-heading font-bold uppercase tracking-wide px-5 py-2.5 rounded-xl text-sm hover:bg-[#222] transition-colors">
      List Your Vehicle →
    </a>
  </div>

  <!-- Cross-links to the other sections -->
  <div class="mt-16 pt-10 border-t border-[#DDD9D3]">
    <h2 class="font-heading font-bold uppercase text-xl text-[#111111] mb-5">More on Land Cruiser SA</h2>
    <div class="flex flex-wrap gap-2">
      <a href={family === 'Hilux' ? '/fortuner/' : '/hilux/'} class="section-chip">{family === 'Hilux' ? 'Fortuners' : 'Hiluxes'} for sale</a>
      <a href="/listings/" class="section-chip">Land Cruisers for sale</a>
      <a href="/fj-cruiser/" class="section-chip">FJ Cruisers</a>
      <a href="/classics/" class="section-chip">Classic Cruisers</a>
      <a href="/game-viewers/" class="section-chip">Game Viewers</a>
      <a href="/market/" class="section-chip">Live market data</a>
    </div>
  </div>

</div>

</Base>
{/* Base canonicalises to the bare pathname, so filtered/paginated views all
    point at page 1 automatically; breadcrumb schema goes through Base. */}

<style>
  .card-img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #F5F3EE; }
  .card-badges { position: absolute; top: 0.75rem; left: 0.75rem; display: flex; gap: 0.35rem; flex-wrap: wrap; max-width: calc(100% - 1.5rem); }
  .card-badge { background: #111111; color: white; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.2rem 0.5rem; border-radius: 0.25rem; }
  .card-badge-featured { background: #F5A623; color: #111111; box-shadow: 0 1px 4px rgba(0,0,0,0.25); }
  .card-badge-drop { position: absolute; top: 0.75rem; right: 0.75rem; background: #16803C; color: white; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.2rem 0.5rem; border-radius: 0.25rem; }
  .filter-pill { font-size: 0.75rem; font-weight: 600; color: #6B7280; background: #fff; border: 1px solid #DDD9D3; border-radius: 9999px; padding: 0.3rem 0.8rem; transition: all 0.15s; display: inline-block; }
  .filter-pill:hover { border-color: #F5A623; color: #111; }
  .filter-pill.active { background: #111; color: #fff; border-color: #111; }
  .section-chip { padding: 0.5rem 1rem; border: 1px solid #DDD9D3; border-radius: 9999px; font-size: 0.875rem; color: #4A4A4A; transition: colors 0.15s; }
