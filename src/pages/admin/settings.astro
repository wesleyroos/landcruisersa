---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { getCredentials } from '@/lib/instagram';
import { boostConfigured, boostEnabled, boostPriceRand } from '@/lib/social-boost';

const cookie = Astro.cookies.get('lcsa_admin');
const adminSecret = import.meta.env.ADMIN_SECRET ?? process.env.ADMIN_SECRET ?? '';
if (!cookie || cookie.value !== adminSecret) {
  return Astro.redirect('/admin/login');
}

const creds = await getCredentials();
const connected = !!creds;

const boostReady = boostConfigured();   // Paystack keys present?
const boostOn = boostEnabled();
const boostPrice = boostPriceRand();

const urlError   = Astro.url.searchParams.get('error');
const urlSuccess = Astro.url.searchParams.get('connected');

const errorMessages: Record<string, string> = {
  denied:         'You denied the Instagram authorisation.',
  missing_params: 'OAuth callback was missing required parameters.',
  invalid_state:  'OAuth state mismatch — please try again.',
  token_exchange: 'Failed to exchange the authorisation code for a token.',
  not_configured: 'Instagram credentials are not configured on the server.',
};
---

<AdminLayout title="Settings" activePage="settings">

  <div class="settings-wrap">

    <div class="settings-section">
      <h2 class="settings-heading">Instagram</h2>

      <div class={`conn-card ${connected ? 'conn-card-ok' : 'conn-card-off'}`}>
        <div class="conn-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <div class="conn-body">
          {connected ? (
            <>
              <p class="conn-title">Connected as <strong>@{creds!.username}</strong></p>
              <p class="conn-sub">Long-lived token · auto-refreshed weekly (no action needed)</p>
            </>
          ) : (
            <>
              <p class="conn-title">Not connected</p>
              <p class="conn-sub">Connect your Instagram Business account to enable posting from the Publishing page</p>
            </>
          )}
        </div>
        <div class="conn-actions">
          {connected ? (
            <>
              <button id="refresh-token-btn" class="btn btn-outline">Refresh Token</button>
              <button id="disconnect-btn"    class="btn btn-danger">Disconnect</button>
            </>
          ) : (
            <a href="/api/admin/instagram/connect" class="btn btn-ig">Connect Instagram</a>
          )}
        </div>
      </div>

      {urlSuccess && (
        <div class="alert alert-ok">Instagram connected successfully.</div>
      )}
      {urlError && (
        <div class="alert alert-err">{errorMessages[urlError] ?? 'Something went wrong.'}</div>
      )}
    </div>

    <div class="settings-section">
      <h2 class="settings-heading">Paid social boost</h2>

      <div class={`conn-card ${boostOn ? 'conn-card-ok' : 'conn-card-off'}`}>
        <div class="conn-icon">📣</div>
        <div class="conn-body">
          <p class="conn-title">
            {!boostReady
              ? 'Paystack not connected'
              : boostOn ? `Live — sellers are offered it at R${boostPrice}` : 'Off — sellers are not offered it'}
          </p>
          <p class="conn-sub">
            {!boostReady
              ? 'Set PAYSTACK_SECRET_KEY and PAYSTACK_PUBLIC_KEY on the server, then this can be switched on.'
              : 'Private sellers can pay to have their vehicle posted to our Instagram and Facebook pages. Paid boosts show up in the pending queue and email you.'}
          </p>
        </div>
        <div class="conn-actions">
          <input id="boost-price" class="price-input" type="number" min="10" max="5000" step="1"
                 value={boostPrice} disabled={!boostReady} aria-label="Boost price in rand" />
          <button id="boost-save" class="btn btn-outline" disabled={!boostReady}>Save price</button>
          <button id="boost-toggle" class={`btn ${boostOn ? 'btn-danger' : 'btn-ig'}`} disabled={!boostReady}
                  data-on={boostOn ? '1' : '0'}>{boostOn ? 'Switch off' : 'Switch on'}</button>
        </div>
      </div>
    </div>

  </div>

  <div id="toast" class="toast" hidden></div>

</AdminLayout>

<style>
  .settings-wrap { display: flex; flex-direction: column; gap: 2rem; max-width: 640px; }

  .settings-section { display: flex; flex-direction: column; gap: 0.875rem; }
  .settings-heading {
    font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    color: #9CA3AF; padding-bottom: 0.75rem; border-bottom: 1.5px solid #F3F4F6;
  }

  .conn-card {
    border: 1.5px solid #E5E7EB; border-radius: 0.875rem;
    padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
  }
  .conn-card-ok  { border-color: #111111; }
  .conn-card-off { border-color: #E5E7EB; }

  .conn-icon { color: #111111; flex-shrink: 0; }
  .conn-card-off .conn-icon { color: #9CA3AF; }

  .conn-body { flex: 1; min-width: 0; }
  .conn-title { font-size: 0.9rem; font-weight: 700; color: #111111; }
  .conn-sub   { font-size: 0.72rem; color: #9CA3AF; margin-top: 0.15rem; }

  .conn-actions { display: flex; gap: 0.5rem; flex-shrink: 0; flex-wrap: wrap; align-items: center; }
  .price-input {
    width: 5.5rem; border: 1.5px solid #E5E7EB; border-radius: 0.375rem;
    padding: 0.4rem 0.55rem; font-size: 0.8rem; font-weight: 700; color: #111111;
  }
  .price-input:disabled { background: #F9FAFB; color: #9CA3AF; }

  .alert { margin-top: 0.25rem; border-radius: 0.5rem; padding: 0.625rem 1rem; font-size: 0.8rem; font-weight: 600; }
  .alert-ok  { background: #DCFCE7; color: #166534; }
  .alert-err { background: #FEF2F2; color: #991B1B; }

  .btn {
    font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em;
    padding: 0.45rem 0.875rem; border-radius: 0.375rem; cursor: pointer;
    border: 1.5px solid transparent; transition: all 0.15s; white-space: nowrap;
    text-decoration: none; display: inline-block; text-align: center; line-height: 1.5;
  }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-ig      { background: #111111; color: white; border-color: #111111; }
  .btn-ig:hover { background: #374151; border-color: #374151; }
  .btn-outline  { background: white; color: #6B7280; border-color: #E5E7EB; }
  .btn-outline:hover { color: #111111; border-color: #111111; }
  .btn-danger   { background: white; color: #9CA3AF; border-color: #E5E7EB; }
  .btn-danger:hover { background: #FEF2F2; color: #991B1B; border-color: #FECACA; }

  .toast {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 100;
    background: #111111; color: white; font-size: 0.8rem; font-weight: 600;
    padding: 0.75rem 1.25rem; border-radius: 0.625rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2); transition: opacity 0.3s;
  }
  .toast[hidden] { display: none; }
  .toast-ok  { background: #166534; }
  .toast-err { background: #991B1B; }
</style>

<script>
  const toast = document.getElementById('toast')!;

  function showToast(msg: string, type: 'ok' | 'err') {
    toast.textContent = msg;
    toast.className = `toast toast-${type}`;
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 3500);
  }

  document.getElementById('refresh-token-btn')?.addEventListener('click', async function () {
    const btn = this as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Refreshing…';
    try {
      const res  = await fetch('/api/admin/instagram/refresh-token', { method: 'POST' });
      const data = await res.json();
      showToast(res.ok ? 'Token refreshed.' : (data.error ?? 'Refresh failed'), res.ok ? 'ok' : 'err');
    } finally {
      btn.disabled = false; btn.textContent = 'Refresh Token';
    }
  });

  async function saveBoost(payload: Record<string, unknown>, btn: HTMLButtonElement, label: string) {
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/admin/social-boost-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) { showToast(data.error ?? 'Could not save.', 'err'); btn.disabled = false; btn.textContent = label; return; }
      showToast('Saved.', 'ok');
      if ('enabled' in payload) { location.reload(); return; }
      btn.disabled = false; btn.textContent = label;
    } catch {
      showToast('Network error.', 'err');
      btn.disabled = false; btn.textContent = label;
    }
  }

  document.getElementById('boost-save')?.addEventListener('click', function () {
    const price = Number((document.getElementById('boost-price') as HTMLInputElement).value);
    saveBoost({ price }, this as HTMLButtonElement, 'Save price');
  });

  document.getElementById('boost-toggle')?.addEventListener('click', function () {
    const btn = this as HTMLButtonElement;
    const turningOn = btn.dataset.on !== '1';
    if (turningOn && !confirm('Switch the paid social boost on? Sellers will be charged real money and we commit to posting their vehicle.')) return;
    saveBoost({ enabled: turningOn }, btn, turningOn ? 'Switch on' : 'Switch off');
  });

  document.getElementById('disconnect-btn')?.addEventListener('click', async function () {
    if (!confirm('Disconnect Instagram? You\'ll need to re-authorise to post again.')) return;
    const btn = this as HTMLButtonElement;
    btn.disabled = true;
    await fetch('/api/admin/instagram/disconnect', { method: 'POST' });
    location.reload();
  });
</script>
