---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { buildMasterList } from '@/lib/people';
import {
  users, favorites, savedSearches, contacts, listings,
  enquiries, trainingLeads, wantedRequests, financeLeads,
  valuationRequests, valuationCertificates,
} from '@/db/schema';
import { desc, sql } from 'drizzle-orm';

const cookie = Astro.cookies.get('lcsa_admin');
const adminSecret = import.meta.env.ADMIN_SECRET ?? process.env.ADMIN_SECRET ?? '';
if (!cookie || cookie.value !== adminSecret) {
  return Astro.redirect('/admin/login');
}

// The master list is built in @/lib/people so the Engage sync uses exactly the
// same people this page shows.
const { master, sourceTotals, masterTotal, consentedTotal, recordTotal } = buildMasterList();

const SOURCE_ORDER = ['Account', 'Seller', 'Certificate', 'Valuation', 'Finance', 'Training', 'Wanted', 'Enquiry', 'WP shop', 'WP contact', 'WP account'];
const sourceChips = SOURCE_ORDER.filter(s => sourceTotals.has(s)).map(s => ({ s, n: sourceTotals.get(s)! }));

const fmtMs = (ms: number | null) => ms ? new Date(ms).toLocaleDateString('en-ZA', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
const consentLabel = (p: Person) =>
  !p.consentAt ? '' : p.consentSource?.startsWith('bulk-import') ? 'imported' : (p.consentSource ?? 'opt-in');

// Client payload for search/filter + master CSV export
const clientRows = master.map(p => ({
  n: p.name, e: p.email, ph: p.phone,
  s: Object.entries(p.sources).map(([k, v]) => v > 1 ? `${k} ×${v}` : k),
  c: p.consentAt ? 1 : 0, cs: consentLabel(p),
  f: p.first, l: p.last, a: p.notes.join(' · '),
}));
const rowsJson = JSON.stringify(clientRows).replace(/</g, '\\u003c');
---

<AdminLayout title="Users" activePage="users">
  <div class="ib">
    <div class="topbar">
      <button id="master-csv" class="export-btn ghost" type="button">⬇ Master CSV</button>
      <button id="export-btn" class="export-btn" type="button">⬇ Meta audience CSV</button>
    </div>

    <div class="stats">
      <div class="stat wide"><span class="num">{masterTotal}</span><span class="lbl">Total people</span><span class="hint">every source, de-duplicated</span></div>
      <div class="stat"><span class="num">{consentedTotal}</span><span class="lbl">With consent</span><span class="hint">{masterTotal ? Math.round(consentedTotal / masterTotal * 100) : 0}% of the base</span></div>
      <div class="stat"><span class="num">{recordTotal}</span><span class="lbl">Raw records</span><span class="hint">before de-duplication</span></div>
    </div>

    <section class="card">
      <h2>Master list <span class="count">{masterTotal}</span></h2>
      <p class="sub">
        One row per person across everything: accounts, private sellers, the old WordPress
        import, enquiries, training, game-viewer wanted requests, finance leads, valuations
        and certificate downloads. Consent = a recorded opt-in (“imported” = the honest
        bulk backfill, not an individual tick). Click a source chip to filter.
      </p>
      <div class="filters">
        <input id="q" type="search" placeholder="Search name, email or phone…" autocomplete="off" />
        <div class="chips">
          <button class="chip active" data-src="">All {masterTotal}</button>
          {sourceChips.map(c => <button class="chip" data-src={c.s}>{c.s} {c.n}</button>)}
          <button class="chip" data-src="__noconsent">No consent {masterTotal - consentedTotal}</button>
        </div>
      </div>
      <table id="master-table">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Sources</th><th>Consent</th><th>Activity</th><th>First seen</th><th>Last seen</th></tr></thead>
        <tbody>
          {master.map(p => (
            <tr data-src={Object.keys(p.sources).join('|')} data-consent={p.consentAt ? '1' : '0'}
                data-q={`${p.name} ${p.email} ${p.phone}`.toLowerCase()}>
              <td class="b">{p.name || '—'}</td>
              <td>{p.email ? <a href={`mailto:${p.email}`}>{p.email}</a> : '—'}</td>
              <td class="nowrap">{p.phone ? <a href={`tel:${p.phone}`}>{p.phone}</a> : '—'}</td>
              <td class="srcs">{Object.entries(p.sources).map(([s, n]) => <span class="src">{s}{n > 1 ? ` ×${n}` : ''}</span>)}</td>
              <td class="nowrap">{p.consentAt ? <span class={consentLabel(p) === 'imported' ? 'cons imported' : 'cons'} title={fmtMs(p.consentAt)}>✅ <i>{consentLabel(p)}</i></span> : <span class="muted">—</span>}</td>
              <td class="muted small">{p.notes.join(' · ') || '—'}</td>
              <td class="nowrap muted small">{fmtMs(p.first)}</td>
              <td class="nowrap muted small">{fmtMs(p.last)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p id="no-rows" class="empty" hidden>Nothing matches that filter.</p>
    </section>
  </div>

  <div id="export-modal" class="modal-backdrop" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="export-title">
      <h3 id="export-title">Export to CSV</h3>
      <p class="modal-sub">
        Pick which lists to include. The file is formatted for a <b>Meta Custom
        Audience</b> — email, phone (E.164), first &amp; last name, country — with
        consent columns so you can filter to opted-in people before uploading.
      </p>
      <div class="opts">
        <label class="opt"><input type="checkbox" class="exp-list" value="users" checked /> <span>Users</span></label>
        <label class="opt"><input type="checkbox" class="exp-list" value="sellers" checked /> <span>Private sellers</span></label>
        <label class="opt"><input type="checkbox" class="exp-list" value="contacts" checked /> <span>Legacy contacts</span></label>
      </div>
      <div class="modal-actions">
        <button id="export-cancel" class="btn-ghost" type="button">Cancel</button>
        <button id="export-go" class="btn-fill" type="button">Download CSV</button>
      </div>
    </div>
  </div>

  <script define:vars={{ rowsJson }}>
    // ── Search + source filter ──
    const rows = Array.from(document.querySelectorAll('#master-table tbody tr'));
    const q = document.getElementById('q');
    const noRows = document.getElementById('no-rows');
    let activeSrc = '';
    function apply() {
      const needle = (q?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const tr of rows) {
        const srcs = (tr.getAttribute('data-src') ?? '').split('|');
        const okSrc = !activeSrc
          || (activeSrc === '__noconsent' ? tr.getAttribute('data-consent') === '0' : srcs.includes(activeSrc));
        const okQ = !needle || (tr.getAttribute('data-q') ?? '').includes(needle);
        const show = okSrc && okQ;
        tr.hidden = !show;
        if (show) shown++;
      }
      if (noRows) noRows.hidden = shown > 0;
    }
    q?.addEventListener('input', apply);
    document.querySelectorAll('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        activeSrc = chip.getAttribute('data-src') ?? '';
        apply();
      });
    });

    // ── Master CSV (the de-duplicated list, built client-side) ──
    document.getElementById('master-csv')?.addEventListener('click', () => {
      const data = JSON.parse(rowsJson);
      const esc = (v) => '"' + String(v ?? '').replace(/"/g, '""') + '"';
      const lines = ['name,email,phone,sources,consent,consent_source,first_seen,last_seen,activity'];
      for (const r of data) {
        lines.push([
          esc(r.n), esc(r.e), esc(r.ph), esc(r.s.join(' | ')),
          r.c ? 'yes' : 'no', esc(r.cs),
          r.f ? new Date(r.f).toISOString().slice(0, 10) : '',
          r.l ? new Date(r.l).toISOString().slice(0, 10) : '',
          esc(r.a),
        ].join(','));
      }
      const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'lcsa-master-users.csv';
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // ── Meta audience export modal (unchanged, server-generated) ──
    const btn = document.getElementById('export-btn');
    const modal = document.getElementById('export-modal');
    const cancel = document.getElementById('export-cancel');
    const go = document.getElementById('export-go');
    const close = () => { if (modal) modal.hidden = true; };
    btn?.addEventListener('click', () => { if (modal) modal.hidden = false; });
    cancel?.addEventListener('click', close);
    modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    go?.addEventListener('click', () => {
      const lists = Array.from(document.querySelectorAll('.exp-list:checked')).map((c) => c.value);
      if (lists.length === 0) { alert('Pick at least one list to export.'); return; }
      window.location.href = '/api/admin/export-users?lists=' + encodeURIComponent(lists.join(','));
      close();
    });
  </script>
</AdminLayout>

<style>
  .ib { display: flex; flex-direction: column; gap: 1.5rem; max-width: 1250px; }
  .stats { display: flex; gap: 1rem; flex-wrap: wrap; }
  .stat { background: #fff; border: 1px solid #E5E7EB; border-radius: 0.75rem; padding: 1rem 1.5rem; display: flex; flex-direction: column; min-width: 120px; }
  .stat .num { font-size: 1.75rem; font-weight: 800; color: #111; line-height: 1; }
  .stat .lbl { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #9CA3AF; margin-top: 0.35rem; }
  .stat .hint { font-size: 0.66rem; color: #B6BCC6; margin-top: 0.2rem; }
  .stat.wide { border-color: #F5A623; }
  .stat.wide .lbl { color: #D4881A; }
  .card { background: #fff; border: 1px solid #E5E7EB; border-radius: 0.75rem; padding: 1.25rem 1.5rem; }
  h2 { font-size: 1rem; font-weight: 700; color: #111; display: flex; align-items: center; gap: 0.5rem; }
  .count { background: #F5A623; color: #111; font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.5rem; border-radius: 999px; }
  .sub { font-size: 0.8rem; color: #6B7280; margin: 0.3rem 0 1rem; }
  .empty { font-size: 0.875rem; color: #9CA3AF; padding: 0.5rem 0; }

  .filters { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.9rem; }
  .filters input { border: 1px solid #E5E7EB; border-radius: 0.6rem; padding: 0.5rem 0.8rem; font-size: 0.85rem; max-width: 22rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chip { border: 1px solid #E5E7EB; background: #fff; border-radius: 999px; padding: 0.25rem 0.7rem; font-size: 0.72rem; font-weight: 600; color: #374151; cursor: pointer; }
  .chip:hover { background: #F9FAFB; }
  .chip.active { background: #111; color: #fff; border-color: #111; }

  table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  th { text-align: left; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9CA3AF; padding: 0.5rem 0.6rem; border-bottom: 1px solid #E5E7EB; }
  td { padding: 0.55rem 0.6rem; border-bottom: 1px solid #F3F4F6; color: #374151; vertical-align: top; }
  tr:last-child td { border-bottom: none; }
  .b { font-weight: 700; color: #111; }
  .muted { color: #9CA3AF; }
  .small { font-size: 0.72rem; }
  .nowrap { white-space: nowrap; }
  td a { color: #D4881A; text-decoration: none; }
  td a:hover { text-decoration: underline; }
  .srcs { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .src { background: #F3F4F6; border-radius: 0.35rem; padding: 0.1rem 0.45rem; font-size: 0.68rem; font-weight: 600; color: #374151; white-space: nowrap; }
  .cons i { font-style: normal; font-size: 0.68rem; color: #6B7280; }
  .cons.imported i { color: #B6893B; }

  .topbar { display: flex; justify-content: flex-end; gap: 0.6rem; }
  .export-btn {
    background: #111; color: #fff; border: none; border-radius: 0.6rem;
    padding: 0.55rem 1.1rem; font-size: 0.8rem; font-weight: 700; cursor: pointer;
  }
  .export-btn:hover { background: #000; }
  .export-btn.ghost { background: #fff; color: #111; border: 1px solid #E5E7EB; }
  .export-btn.ghost:hover { background: #F9FAFB; }

  .modal-backdrop {
    position: fixed; inset: 0; background: rgba(17,24,39,0.55);
    display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 100;
  }
  .modal-backdrop[hidden] { display: none; }
  .modal {
    background: #fff; border-radius: 0.9rem; padding: 1.5rem; max-width: 26rem; width: 100%;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
  }
  .modal h3 { font-size: 1.05rem; font-weight: 800; color: #111; margin: 0 0 0.5rem; }
  .modal-sub { font-size: 0.8rem; color: #6B7280; margin: 0 0 1rem; line-height: 1.45; }
  .opts { display: flex; flex-direction: column; gap: 0.15rem; margin-bottom: 1.25rem; }
  .opt {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.7rem;
    border: 1px solid #E5E7EB; border-radius: 0.6rem; cursor: pointer; font-size: 0.875rem; color: #374151;
  }
  .opt:hover { background: #F9FAFB; }
  .opt input { accent-color: #F5A623; width: 17px; height: 17px; cursor: pointer; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 0.6rem; }
  .btn-ghost { background: none; border: 1px solid #E5E7EB; border-radius: 0.6rem; padding: 0.55rem 1rem; font-size: 0.8rem; font-weight: 600; color: #374151; cursor: pointer; }
  .btn-ghost:hover { background: #F9FAFB; }
  .btn-fill { background: #F5A623; border: none; border-radius: 0.6rem; padding: 0.55rem 1rem; font-size: 0.8rem; font-weight: 700; color: #111; cursor: pointer; }
</style>
