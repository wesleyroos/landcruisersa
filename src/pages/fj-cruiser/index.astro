---
export const prerender = false;

import Base from '@/layouts/Base.astro';
import { SITE } from '@/data/site';
import { db } from '@/db/index';
import { listings } from '@/db/schema';
import { and, eq, desc, inArray } from 'drizzle-orm';
import { firstThumb, hasUsablePhoto } from '@/lib/photos';
import { getRecentPriceChanges } from '@/lib/price-changes';

// The FJ family as one vertical — the retro FJ Cruiser (2011–2023, discontinued,
// trading as a modern classic) and the new-for-2026 Land Cruiser FJ that revives
// the name. Buyers search "fj cruiser for sale" for both; one page serves the
// whole family with a filter, the way /game-viewers/ handles base vehicles.
// Consolidated from /listings/model/fj-cruiser/ (301s here) per the P12 review.
const FJ_MODELS = ['fj-cruiser', 'land-cruiser-fj'];

let results = await db.select().from(listings)
  .where(and(eq(listings.status, 'active'), inArray(listings.model, FJ_MODELS)))
  .orderBy(desc(listings.featured), desc(listings.created_at));
results = results.filter(l => hasUsablePhoto(l.photos));

function formatPrice(n: number) { return 'R' + n.toLocaleString('en-ZA'); }
function formatMileage(n: number) { return n.toLocaleString('en-ZA') + ' km'; }

// Per-group market stats — one median across a 2012 cult classic and a brand-new
// 2026 GX would mislead both buyers, so the strip is split by generation.
function groupStats(model: string) {
  const group = results.filter(l => l.model === model);
  const priced = group
    .filter(l => l.listing_type === 'for_sale' && l.price > 0)
    .map(l => l.price)
    .sort((a, b) => a - b);
  const n = priced.length;
  const median = n
    ? (n % 2 ? priced[(n - 1) / 2] : Math.round((priced[n / 2 - 1] + priced[n / 2]) / 2))
    : 0;
  const kms = group.filter(l => l.listing_type === 'for_sale' && l.mileage > 0).map(l => l.mileage);
  const years = group.map(l => l.year);
  return {
    count: group.length,
    priceCount: n,
    median,
    min: n ? priced[0] : 0,
    max: n ? priced[n - 1] : 0,
    avgKm: kms.length ? Math.round(kms.reduce((s, m) => s + m, 0) / kms.length) : null,
    yearSpan: years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '—',
  };
}
const retro = groupStats('fj-cruiser');
const modern = groupStats('land-cruiser-fj');

const priceChanges = getRecentPriceChanges();
const dropBySlug = new Map<string, number>();
for (const l of results) {
  const c = priceChanges.get(l.slug) ?? 0;
  if (c < 0) dropBySlug.set(l.slug, Math.abs(c));
}

const kR = (n: number) =>
  n >= 1_000_000 ? 'R' + (n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 1) + 'm' : 'R' + Math.round(n / 1000) + 'k';

const canonicalUrl = `${SITE.url}/fj-cruiser/`;
const title = 'Toyota FJ Cruisers For Sale in South Africa';
const descParts: string[] = [];
if (retro.priceCount >= 2) descParts.push(`FJ Cruiser (2011–2023) median asking ${formatPrice(retro.median)}`);
if (modern.priceCount >= 2) descParts.push(`new Land Cruiser FJ from ${formatPrice(modern.min)}`);
const description = results.length
  ? `Browse ${results.length} Toyota FJ Cruiser${results.length !== 1 ? 's' : ''} for sale in South Africa — the original retro FJ and the new 2026 Land Cruiser FJ${descParts.length ? `. ${descParts.join(' · ')}` : ''}. Updated daily.`
  : 'Toyota FJ Cruiser classifieds in South Africa — the original 2011–2023 FJ Cruiser and the new 2026 Land Cruiser FJ, from dealers and private sellers. Updated daily.';
---

<Base
  title={`${title} — Land Cruiser SA`}
  description={description}
  schema={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
      { "@type": "ListItem", "position": 2, "name": "Listings", "item": `${SITE.url}/listings/` },
      { "@type": "ListItem", "position": 3, "name": "FJ Cruisers", "item": canonicalUrl },
    ],
  }}
>

  <div class="bg-[#111111]">
    <div class="max-w-7xl mx-auto px-4 py-8 sm:py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <nav class="flex items-center gap-2 text-xs text-white/40 mb-4">
          <a href="/" class="hover:text-[#F5A623] transition-colors">Home</a>
          <span>›</span>
          <a href="/listings/" class="hover:text-[#F5A623] transition-colors">Listings</a>
          <span>›</span>
          <span class="text-white/70">FJ Cruisers</span>
        </nav>
        <p class="text-[#F5A623] font-heading font-bold uppercase tracking-widest text-xs mb-2">FJ Cruiser · Land Cruiser FJ</p>
        <h1 class="font-heading font-bold uppercase text-white text-4xl md:text-5xl leading-none mb-3">{title}</h1>
        <p class="text-white/50 text-sm">{results.length} active listing{results.length !== 1 ? 's' : ''} · the original retro FJ and the new 2026 Land Cruiser FJ</p>
      </div>
      <a href="/listings/submit/" class="inline-flex items-center gap-2 bg-[#F5A623] text-[#111111] font-heading font-bold uppercase tracking-wide px-6 py-3.5 rounded-xl hover:bg-[#D4881A] transition-colors text-sm self-start sm:self-auto touch-manipulation whitespace-nowrap">
        + List Your FJ
      </a>
    </div>
  </div>
  <div class="h-1 bg-[#F5A623]"></div>

  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-10">

    {(retro.priceCount >= 2 || modern.priceCount >= 2) && (
      <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        {retro.priceCount >= 2 && (
          <div class="bg-white border border-[#DDD9D3] rounded-xl px-5 py-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#F5A623] mb-2">FJ Cruiser · 2011–2023</p>
            <div class="grid grid-cols-3 gap-x-4 gap-y-3">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Median asking</p>
                <p class="font-heading font-bold text-lg text-[#111111]">{formatPrice(retro.median)}</p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Range</p>
                <p class="font-heading font-bold text-lg text-[#111111]">{kR(retro.min)} – {kR(retro.max)}</p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Avg mileage</p>
                <p class="font-heading font-bold text-lg text-[#111111]">{retro.avgKm ? formatMileage(retro.avgKm) : '—'}</p>
              </div>
            </div>
          </div>
        )}
        {modern.priceCount >= 2 && (
          <div class="bg-white border border-[#DDD9D3] rounded-xl px-5 py-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#F5A623] mb-2">Land Cruiser FJ · New for 2026</p>
            <div class="grid grid-cols-3 gap-x-4 gap-y-3">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Median asking</p>
                <p class="font-heading font-bold text-lg text-[#111111]">{formatPrice(modern.median)}</p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Range</p>
                <p class="font-heading font-bold text-lg text-[#111111]">{kR(modern.min)} – {kR(modern.max)}</p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">For sale</p>
                <p class="font-heading font-bold text-lg text-[#111111]">{modern.priceCount}</p>
              </div>
            </div>
          </div>
        )}
      </div>
    )}

    {results.length === 0 ? (
      <div class="text-center py-24">
        <p class="text-[#6B7280] text-lg mb-4">No active FJ listings right now.</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/listings/?model=fj&alert=1" class="inline-flex items-center gap-1.5 bg-[#F5A623] text-[#111111] font-heading font-bold uppercase tracking-wide px-6 py-3 rounded-xl text-sm hover:bg-[#D4881A] transition-colors">
            Alert me when one is listed
          </a>
          <a href="/listings/" class="text-sm font-semibold text-[#6B7280] hover:text-[#111111] hover:underline px-2">Browse all listings</a>
        </div>
      </div>
    ) : (
      <>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-1.5 flex-wrap">
          <button class="filter-btn active" data-filter="all" type="button">All ({results.length})</button>
          <button class="filter-btn" data-filter="fj-cruiser" type="button">FJ Cruiser 2011–2023 ({retro.count})</button>
          <button class="filter-btn" data-filter="land-cruiser-fj" type="button">New Land Cruiser FJ ({modern.count})</button>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-xs text-[#9CA3AF] mr-1">Sort:</span>
          <button class="sort-btn active" data-sort="newest" type="button">Newest</button>
          <button class="sort-btn" data-sort="price" type="button">Price: low → high</button>
        </div>
      </div>
      <div id="fj-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {results.map((l, i) => (
          <a
            href={`/listings/${l.slug}/`}
            data-idx={i}
            data-model={l.model}
            data-price={l.listing_type === 'for_sale' && l.price > 0 ? l.price : ''}
            class="group border rounded-xl overflow-hidden transition-all flex flex-col bg-white border-[#DDD9D3] hover:border-[#F5A623] hover:shadow-md"
          >
            <div class="card-img">
              <img
                src={firstThumb(l.photos)}
                alt={l.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width="800" height="500"
                loading={i < 6 ? 'eager' : 'lazy'}
                fetchpriority={i < 3 ? 'high' : 'auto'}
                decoding="async"
              />
              <div class="card-badges">
                {l.featured && <span class="card-badge card-badge-featured">★ Featured</span>}
                {l.province && <span class="card-badge">{l.province}</span>}
              </div>
              {dropBySlug.has(l.slug) && (
                <span class="card-badge-drop">▼ R{dropBySlug.get(l.slug)!.toLocaleString('en-ZA')} drop</span>
              )}
            </div>
            <div class="p-4 sm:p-5 flex flex-col flex-1">
              <h2 class="font-heading font-bold uppercase text-base leading-tight mb-1 group-hover:text-[#F5A623] transition-colors line-clamp-2 text-[#111111]">
                {l.title}
              </h2>
              <p class="text-xs mb-4 truncate text-[#6B7280]">
                {l.mileage > 0 ? `${formatMileage(l.mileage)} · ` : ''}{l.transmission === 'manual' ? 'Manual' : 'Auto'} · {l.province}
              </p>
              <div class="mt-auto">
                {l.listing_type === 'for_sale' && l.price > 0
                  ? <p class="font-heading font-bold text-2xl text-[#111111]">{formatPrice(l.price)}</p>
                  : <span class="text-xs font-bold text-[#F5A623] uppercase tracking-wide">POA</span>
                }
              </div>
            </div>
          </a>
        ))}
      </div>
      </>
    )}

    <!-- Definition + guide links — the "answer capsule" LLMs cite (position on
         the page doesn't affect citation/SEO; the top stays listings-first) -->
    <div class="mt-12">
      <h2 class="font-heading font-bold uppercase text-xl text-[#111111] mb-3">The FJ family, explained</h2>
      <p class="text-sm text-[#4A4A4A] leading-relaxed max-w-3xl">
        The original <strong>Toyota FJ Cruiser</strong> — the retro tribute to the FJ40, always powered by the
        4.0-litre V6 petrol — was sold new in South Africa from 2011 and is long discontinued, which is exactly
        why clean examples now trade as modern classics with unusually strong resale.
        {retro.priceCount >= 2 && <> Current asking prices run {kR(retro.min)}–{kR(retro.max)} (median {formatPrice(retro.median)}).</>}
        {' '}The name returned in 2026 with the all-new <strong>Land Cruiser FJ</strong> — a compact,
        ladder-frame Land Cruiser with the 2.7-litre petrol engine, now in SA showrooms
        {modern.priceCount >= 2 && <> from {formatPrice(modern.min)}</>}.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3 text-sm">
        <a href="/models/fj-cruiser/" class="font-semibold text-[#D4881A] hover:underline">FJ Cruiser model guide →</a>
        <a href="/models/land-cruiser-fj/" class="font-semibold text-[#D4881A] hover:underline">Land Cruiser FJ (2026) guide →</a>
        <a href="/market/fj-cruiser/" class="font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">FJ Cruiser market data →</a>
        <a href="/valuation/fj-cruiser/" class="font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">Own one? See what it's worth →</a>
        <a href="/listings/?model=fj&alert=1" class="inline-flex items-center gap-1.5 font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          Alert me when one is listed
        </a>
      </div>
    </div>

    <!-- Sell CTA -->
    <div class="mt-12 p-5 bg-[#F5F3EE] border border-[#DDD9D3] rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <p class="text-xs font-bold uppercase tracking-widest text-[#F5A623] mb-1">Selling?</p>
        <p class="font-heading font-bold uppercase text-[#111111] text-base">List your FJ Cruiser on Land Cruiser SA</p>
        <p class="text-sm text-[#6B7280] mt-0.5">Free listing, reviewed within 24 hours — reaches the biggest Cruiser audience in the country.</p>
      </div>
      <a href="/listings/submit/" class="flex-shrink-0 inline-flex items-center bg-[#111111] text-white font-heading font-bold uppercase tracking-wide px-5 py-2.5 rounded-xl text-sm hover:bg-[#222] transition-colors">
        List Your Vehicle →
      </a>
    </div>

    <!-- Other sections -->
    <div class="mt-16 pt-10 border-t border-[#DDD9D3]">
      <h2 class="font-heading font-bold uppercase text-xl text-[#111111] mb-5">Browse by Model</h2>
      <div class="flex flex-wrap gap-2">
        {[
          ['76-series', '76 Series'], ['78-series', '78 Series (Troopcarrier)'], ['79-series', '79 Series'],
          ['80-series', '80 Series'], ['100-series', '100 Series'], ['200-series', '200 Series'],
          ['300-series', '300 Series'], ['prado', 'Prado'],
        ].map(([slug, label]) => (
          <a href={`/listings/model/${slug}/`} class="px-4 py-2 border border-[#DDD9D3] rounded-full text-sm text-[#4A4A4A] hover:border-[#F5A623] hover:text-[#F5A623] transition-colors">
            {label}
          </a>
        ))}
        <a href="/classics/" class="px-4 py-2 border border-[#DDD9D3] rounded-full text-sm text-[#4A4A4A] hover:border-[#F5A623] hover:text-[#F5A623] transition-colors">
          Classic Cruisers
        </a>
        <a href="/game-viewers/" class="px-4 py-2 border border-[#DDD9D3] rounded-full text-sm text-[#4A4A4A] hover:border-[#F5A623] hover:text-[#F5A623] transition-colors">
          Game Viewers
        </a>
      </div>
    </div>

  </div>

</Base>

<script>
  // Filter pills (by generation) + sort toggle — same pure-DOM approach as the
  // other verticals; filter and sort compose.
  const grid = document.getElementById('fj-grid');
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const sortBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-btn'));
  if (grid) {
    filterBtns.forEach(btn => btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.toggle('active', b === btn));
      const want = btn.dataset.filter;
      (Array.from(grid.children) as HTMLElement[]).forEach(el => {
        el.style.display = (want === 'all' || el.dataset.model === want) ? '' : 'none';
      });
    }));
    sortBtns.forEach(btn => btn.addEventListener('click', () => {
      sortBtns.forEach(b => b.classList.toggle('active', b === btn));
      const cards = Array.from(grid.children) as HTMLElement[];
      const key = btn.dataset.sort === 'price'
        ? (el: HTMLElement) => (el.dataset.price ? Number(el.dataset.price) : Infinity)
        : (el: HTMLElement) => Number(el.dataset.idx ?? 0);
      cards.sort((a, b) => key(a) - key(b)).forEach(el => grid.appendChild(el));
    }));
  }
</script>

<style>
  .card-img {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #F5F3EE;
  }
  .card-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    max-width: calc(100% - 1.5rem);
  }
  .card-badge {
    background: #111111;
    color: white;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
  }
  .card-badge-featured {
    background: #F5A623;
    color: #111111;
    box-shadow: 0 1px 4px rgba(0,0,0,0.25);
  }
  .card-badge-drop {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: #16803C;
    color: white;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
  }
  .sort-btn, .filter-btn {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6B7280;
    background: #fff;
    border: 1px solid #DDD9D3;
    border-radius: 9999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
  }
  .sort-btn:hover, .filter-btn:hover { border-color: #F5A623; color: #111; }
  .sort-btn.active, .filter-btn.active { background: #111; color: #fff; border-color: #111; }
</style>
