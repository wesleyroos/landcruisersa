---
export const prerender = false;

import Base from '@/layouts/Base.astro';
import { SITE } from '@/data/site';
import { db } from '@/db/index';
import { listings } from '@/db/schema';
import { and, eq, desc } from 'drizzle-orm';
import { firstThumb, hasUsablePhoto } from '@/lib/photos';
import { getRecentPriceChanges } from '@/lib/price-changes';

// 80 Series vertical (P29) — fifth run of the verticals playbook, but a
// different job to FJ/Hilux: the for-sale queries ALREADY rank top-3, split
// across four pages (the /models/ guide, /listings/, home, the shelf). This
// page consolidates that intent on one dedicated surface. Inventory is thin
// (single digits) — that's the market: the 80 is a cult classic, and the
// scarcity itself is the citable story. The /models/80-series/ GUIDE keeps
// the informational queries; only the shelf 301s here.
let results = await db.select().from(listings)
  .where(and(eq(listings.status, 'active'), eq(listings.model, '80-series')))
  .orderBy(desc(listings.featured), desc(listings.created_at));
results = results.filter(l => hasUsablePhoto(l.photos));

function formatPrice(n: number) { return 'R' + n.toLocaleString('en-ZA'); }
function formatMileage(n: number) { return n.toLocaleString('en-ZA') + ' km'; }

const priced = results
  .filter(l => l.listing_type === 'for_sale' && l.price > 0)
  .map(l => l.price)
  .sort((a, b) => a - b);
const n = priced.length;
const median = n
  ? (n % 2 ? priced[(n - 1) / 2] : Math.round((priced[n / 2 - 1] + priced[n / 2]) / 2))
  : 0;
const kms = results.filter(l => l.mileage > 0).map(l => l.mileage);
const avgKm = kms.length ? Math.round(kms.reduce((s, m) => s + m, 0) / kms.length) : null;
const years = results.map(l => l.year);
const yearSpan = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '—';

const priceChanges = getRecentPriceChanges();
const dropBySlug = new Map<string, number>();
for (const l of results) {
  const c = priceChanges.get(l.slug) ?? 0;
  if (c < 0) dropBySlug.set(l.slug, Math.abs(c));
}

const kR = (nn: number) =>
  nn >= 1_000_000 ? 'R' + (nn / 1_000_000).toFixed(nn % 1_000_000 === 0 ? 0 : 1) + 'm' : 'R' + Math.round(nn / 1000) + 'k';

const canonicalUrl = `${SITE.url}/80-series/`;
const title = 'Land Cruiser 80 Series For Sale in South Africa';
const description = results.length
  ? `${results.length} Toyota Land Cruiser 80 Series for sale in South Africa right now${n >= 2 ? ` — median asking ${formatPrice(median)}, range ${kR(priced[0])}–${kR(priced[n - 1])}` : ''}. The coil-sprung cult classic (1990–1998), aggregated from dealers and private sellers. Updated daily.`
  : 'Toyota Land Cruiser 80 Series classifieds in South Africa — the coil-sprung cult classic (1990–1998), from dealers and private sellers. Updated daily.';
---

<Base
  title={`${title} — Land Cruiser SA`}
  description={description}
  schema={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
      { "@type": "ListItem", "position": 2, "name": "Listings", "item": `${SITE.url}/listings/` },
      { "@type": "ListItem", "position": 3, "name": "80 Series", "item": canonicalUrl },
    ],
  }}
>

  <div class="bg-[#111111]">
    <div class="max-w-7xl mx-auto px-4 py-8 sm:py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <nav class="flex items-center gap-2 text-xs text-white/40 mb-4">
          <a href="/" class="hover:text-[#F5A623] transition-colors">Home</a>
          <span>›</span>
          <a href="/listings/" class="hover:text-[#F5A623] transition-colors">Listings</a>
          <span>›</span>
          <span class="text-white/70">80 Series</span>
        </nav>
        <p class="text-[#F5A623] font-heading font-bold uppercase tracking-widest text-xs mb-2">The Cult Classic · 1990–1998</p>
        <h1 class="font-heading font-bold uppercase text-white text-4xl md:text-5xl leading-none mb-3">{title}</h1>
        <p class="text-white/50 text-sm">{results.length} active listing{results.length !== 1 ? 's' : ''} · every 80 for sale in the country, in one place</p>
      </div>
      <a href="/listings/submit/" class="inline-flex items-center gap-2 bg-[#F5A623] text-[#111111] font-heading font-bold uppercase tracking-wide px-6 py-3.5 rounded-xl hover:bg-[#D4881A] transition-colors text-sm self-start sm:self-auto touch-manipulation whitespace-nowrap">
        + List Your 80
      </a>
    </div>
  </div>
  <div class="h-1 bg-[#F5A623]"></div>

  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-10">

    {n >= 2 && (
      <div class="mb-6 bg-white border border-[#DDD9D3] rounded-xl px-5 py-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[#F5A623] mb-2">Live market · updated daily</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Median asking</p>
            <p class="font-heading font-bold text-lg text-[#111111]">{formatPrice(median)}</p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Range</p>
            <p class="font-heading font-bold text-lg text-[#111111]">{kR(priced[0])} – {kR(priced[n - 1])}</p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Avg mileage</p>
            <p class="font-heading font-bold text-lg text-[#111111]">{avgKm ? formatMileage(avgKm) : '—'}</p>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#9CA3AF] mb-0.5">Years listed</p>
            <p class="font-heading font-bold text-lg text-[#111111]">{yearSpan}</p>
          </div>
        </div>
      </div>
    )}

    {results.length === 0 ? (
      <div class="text-center py-24">
        <p class="text-[#6B7280] text-lg mb-4">No 80 Series listed right now — they never hang around long.</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/listings/?model=80-series&alert=1" class="inline-flex items-center gap-1.5 bg-[#F5A623] text-[#111111] font-heading font-bold uppercase tracking-wide px-6 py-3 rounded-xl text-sm hover:bg-[#D4881A] transition-colors">
            Alert me when one is listed
          </a>
          <a href="/listings/" class="text-sm font-semibold text-[#6B7280] hover:text-[#111111] hover:underline px-2">Browse all listings</a>
        </div>
      </div>
    ) : (
      <>
      <div class="flex flex-wrap items-center justify-end gap-3 mb-4">
        <div class="flex items-center gap-1.5">
          <span class="text-xs text-[#9CA3AF] mr-1">Sort:</span>
          <button class="sort-btn active" data-sort="newest" type="button">Newest</button>
          <button class="sort-btn" data-sort="price" type="button">Price: low → high</button>
        </div>
      </div>
      <div id="v-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {results.map((l, i) => (
          <a
            href={`/listings/${l.slug}/`}
            data-idx={i}
            data-price={l.listing_type === 'for_sale' && l.price > 0 ? l.price : ''}
            class="group border rounded-xl overflow-hidden transition-all flex flex-col bg-white border-[#DDD9D3] hover:border-[#F5A623] hover:shadow-md"
          >
            <div class="card-img">
              <img
                src={firstThumb(l.photos)}
                alt={l.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width="800" height="500"
                loading={i < 6 ? 'eager' : 'lazy'}
                fetchpriority={i < 3 ? 'high' : 'auto'}
                decoding="async"
              />
              <div class="card-badges">
                {l.featured && <span class="card-badge card-badge-featured">★ Featured</span>}
                {l.province && <span class="card-badge">{l.province}</span>}
              </div>
              {dropBySlug.has(l.slug) && (
                <span class="card-badge-drop">▼ R{dropBySlug.get(l.slug)!.toLocaleString('en-ZA')} drop</span>
              )}
            </div>
            <div class="p-4 sm:p-5 flex flex-col flex-1">
              <h2 class="font-heading font-bold uppercase text-base leading-tight mb-1 group-hover:text-[#F5A623] transition-colors line-clamp-2 text-[#111111]">
                {l.title}
              </h2>
              <p class="text-xs mb-4 truncate text-[#6B7280]">
                {l.mileage > 0 ? `${formatMileage(l.mileage)} · ` : ''}{l.transmission === 'manual' ? 'Manual' : 'Auto'} · {l.province}
              </p>
              <div class="mt-auto">
                {l.listing_type === 'for_sale' && l.price > 0
                  ? <p class="font-heading font-bold text-2xl text-[#111111]">{formatPrice(l.price)}</p>
                  : <span class="text-xs font-bold text-[#F5A623] uppercase tracking-wide">POA</span>
                }
              </div>
            </div>
          </a>
        ))}
      </div>
      </>
    )}

    <!-- Citable capsule -->
    <div class="mt-12">
      <h2 class="font-heading font-bold uppercase text-xl text-[#111111] mb-3">Why the 80 Series holds its value</h2>
      <p class="text-sm text-[#4A4A4A] leading-relaxed max-w-3xl">
        The <strong>Land Cruiser 80 Series</strong> (sold in South Africa 1990–1998) was the first
        Cruiser with coil springs all round, a locking centre diff and available factory diff locks —
        the model that turned Land Cruiser ownership into a lifestyle. Engines were the 4.5-litre
        1FZ-FE petrol six or the 4.2-litre 1HZ/1HD diesel six, both famously over-engineered.
        Production ended nearly three decades ago, so supply only shrinks: on any given day there are
        usually only a handful for sale in the whole country{results.length > 0 && <> — <strong>{results.length} right now</strong></>}
        {n >= 2 && <>, with a median asking price of <strong>{formatPrice(median)}</strong> ({kR(priced[0])}–{kR(priced[n - 1])})</>}.
        Clean, unmodified examples command the premium; rust and neglected diesels are the value killers.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3 text-sm">
        <a href="/models/80-series/" class="font-semibold text-[#D4881A] hover:underline">80 Series model guide →</a>
        <a href="/market/80-series/" class="font-semibold text-[#D4881A] hover:underline">80 Series market data →</a>
        <a href="/valuation/80-series/" class="font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">Own one? See what it's worth →</a>
        <a href="/useful-info/land-cruiser-80-series-tyre-size/" class="font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">80 Series tyre sizes →</a>
        <a href="/listings/?model=80-series&alert=1" class="inline-flex items-center gap-1.5 font-semibold text-[#111111] hover:text-[#D4881A] transition-colors">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          Alert me when one is listed
        </a>
      </div>
    </div>

    <!-- Sell CTA -->
    <div class="mt-12 p-5 bg-[#F5F3EE] border border-[#DDD9D3] rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <p class="text-xs font-bold uppercase tracking-widest text-[#F5A623] mb-1">Selling?</p>
        <p class="font-heading font-bold uppercase text-[#111111] text-base">80s sell fast here — list yours free</p>
        <p class="text-sm text-[#6B7280] mt-0.5">Scarce model, national audience of exactly the right buyers, reviewed within 24 hours.</p>
      </div>
      <a href="/listings/submit/" class="flex-shrink-0 inline-flex items-center bg-[#111111] text-white font-heading font-bold uppercase tracking-wide px-5 py-2.5 rounded-xl text-sm hover:bg-[#222] transition-colors">
        List Your Vehicle →
      </a>
    </div>

    <!-- Other sections -->
    <div class="mt-16 pt-10 border-t border-[#DDD9D3]">
      <h2 class="font-heading font-bold uppercase text-xl text-[#111111] mb-5">Browse by Model</h2>
      <div class="flex flex-wrap gap-2">
        {[
          ['76-series', '76 Series'], ['78-series', '78 Series (Troopcarrier)'], ['79-series', '79 Series'],
          ['100-series', '100 Series'], ['200-series', '200 Series'],
          ['300-series', '300 Series'], ['prado', 'Prado'],
        ].map(([slug, label]) => (
          <a href={`/listings/model/${slug}/`} class="section-chip">{label}</a>
        ))}
        <a href="/fj-cruiser/" class="section-chip">FJ Cruisers</a>
        <a href="/classics/" class="section-chip">Classic Cruisers</a>
        <a href="/game-viewers/" class="section-chip">Game Viewers</a>
        <a href="/hilux/" class="section-chip">Hiluxes</a>
        <a href="/fortuner/" class="section-chip">Fortuners</a>
      </div>
    </div>

  </div>

</Base>

<script>
  const grid = document.getElementById('v-grid');
  const sortBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-btn'));
  if (grid) {
    sortBtns.forEach(btn => btn.addEventListener('click', () => {
      sortBtns.forEach(b => b.classList.toggle('active', b === btn));
      const cards = Array.from(grid.children) as HTMLElement[];
      const key = btn.dataset.sort === 'price'
        ? (el: HTMLElement) => (el.dataset.price ? Number(el.dataset.price) : Infinity)
        : (el: HTMLElement) => Number(el.dataset.idx ?? 0);
      cards.sort((a, b) => key(a) - key(b)).forEach(el => grid.appendChild(el));
    }));
  }
</script>

<style>
  .card-img { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #F5F3EE; }
  .card-badges { position: absolute; top: 0.75rem; left: 0.75rem; display: flex; gap: 0.35rem; flex-wrap: wrap; max-width: calc(100% - 1.5rem); }
  .card-badge { background: #111111; color: white; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.2rem 0.5rem; border-radius: 0.25rem; }
  .card-badge-featured { background: #F5A623; color: #111111; box-shadow: 0 1px 4px rgba(0,0,0,0.25); }
  .card-badge-drop { position: absolute; top: 0.75rem; right: 0.75rem; background: #16803C; color: white; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.2rem 0.5rem; border-radius: 0.25rem; }
  .sort-btn { font-size: 0.75rem; font-weight: 600; color: #6B7280; background: #fff; border: 1px solid #DDD9D3; border-radius: 9999px; padding: 0.3rem 0.8rem; cursor: pointer; transition: all 0.15s; }
  .sort-btn:hover { border-color: #F5A623; color: #111; }
  .sort-btn.active { background: #111; color: #fff; border-color: #111; }
  .section-chip { padding: 0.5rem 1rem; border: 1px solid #DDD9D3; border-radius: 9999px; font-size: 0.875rem; color: #4A4A4A; transition: all 0.15s; }
  .section-chip:hover { border-color: #F5A623; color: #F5A623; }
</style>
