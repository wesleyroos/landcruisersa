---
export const prerender = false;

import Post from '@/layouts/Post.astro';
import { getCollection } from 'astro:content';
import { effectiveState, isNoindex } from '@/lib/post-state';
import { requireAdmin } from '@/lib/admin-auth';

// SSR so the guide's live publication state (managed from /admin/posts) applies
// per request: draft → 404 for the public (admins preview it), unlisted →
// reachable + noindex, published → normal. The whole collection is available, so
// a post can be published/unpublished instantly with no rebuild.
const { slug } = Astro.params;
const post = (await getCollection('posts')).find(p => p.slug === slug);
if (!post) return new Response(null, { status: 404 });

const state = effectiveState(post);
const isAdmin = requireAdmin(Astro.cookies);

if (state === 'draft' && !isAdmin) {
  return new Response(null, { status: 404 });
}

// Published guides can be cached (browser/proxy); previews are never cached.
Astro.response.headers.set(
  'Cache-Control',
  state === 'published'
    ? 'public, max-age=0, s-maxage=600, stale-while-revalidate=86400'
    : 'private, no-store',
);

const { Content } = await post.render();
const adminPreview = isAdmin && state !== 'published' ? state : null;
---

<Post post={post} noindex={isNoindex(state)} adminPreview={adminPreview}>
  <Content />
</Post>
